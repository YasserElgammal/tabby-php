{
    "name": "yasser-elgammal/tabby-php",
    "description": "A production-ready, framework-agnostic PHP SDK for Tabby.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "YasserElgammal\\TabbyPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YasserElgammal\\TabbyPhp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
